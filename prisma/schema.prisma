// Facility scheduler — data model.
//
// Postgres everywhere, development included: the schema this runs against in
// production is the schema the tests run against, and migrations are checked in
// rather than pushed by hand.
//
// Role, status and origin are stored as strings rather than Prisma enums. They
// began that way because SQLite has no enums, and they stay that way because it
// keeps adding a role a code change in src/lib/domain.ts — where the allowed
// values are already defined and validated — instead of a schema migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Queries go through the pooler. On a serverless host every request may be a
  // fresh instance, and a few hundred of those would exhaust Postgres'
  // connection limit without one in front.
  url      = env("DATABASE_URL")
  // Migrations need a direct connection: a transaction pooler cannot run the
  // session-level statements they use. Locally the two are the same string.
  directUrl = env("DIRECT_DATABASE_URL")
}

model Team {
  id         String    @id @default(cuid())
  /// Shown on the calendar once a block is approved, e.g. "12U Red".
  name       String    @unique
  /// Archived teams keep their history but can no longer be assigned.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  members  User[]
  assigned AssignedSeries[]
  bookings Booking[]        @relation("BookingTeam")
  released Booking[]        @relation("BookingReleasedFrom")

  @@index([archivedAt])
}

/// A person who may sign in. This table *is* the access control: an address
/// that is not here cannot sign in, even with a valid link.
model User {
  id     String  @id @default(cuid())
  /// Always stored lowercase and trimmed — see normalizeEmail().
  email  String  @unique
  name   String?
  /// HEAD_COACH | APPROVER | SUPER_ADMIN
  role   String
  /// INVITED | ACTIVE | DISABLED
  status String

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  invitedAt    DateTime  @default(now())
  lastSignInAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
  signInTokens SignInToken[]
  requested    Booking[]     @relation("BookingRequestedBy")
  decided      Booking[]     @relation("BookingDecidedBy")

  @@index([role])
  @@index([status])
  @@index([teamId])
}

/// Single-use magic-link token. Only the SHA-256 hash is stored, so a leaked
/// database row cannot be replayed as a sign-in link.
model SignInToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Server-side session. The cookie holds the secret; only its hash is stored,
/// and deleting the row revokes the session immediately.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// A recurring block an admin assigns to a team, e.g. "U9 - White, Saturdays
/// 8:00–9:30, from today through 30 April". Assigned time needs no approval.
///
/// Times are stored as a local calendar date plus minutes from midnight, never
/// as an instant. A series that runs through spring crosses a daylight-saving
/// change, and 8:00 must stay 8:00 on both sides of it.
model AssignedSeries {
  id           String  @id @default(cuid())
  teamId       String
  team         Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  /// 0 = Sunday … 6 = Saturday.
  weekday      Int
  startMinutes Int
  endMinutes   Int
  /// Inclusive "YYYY-MM-DD" bounds.
  startsOn     String
  endsOn       String
  note         String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  occurrences Booking[]

  @@index([teamId])
  @@index([weekday])
}

/// One block of facility time on one day. Assigned occurrences, slots released
/// back to the club, and slots picked up by another team are all this row —
/// there is one row per physical block of time, whoever currently holds it.
model Booking {
  id           String @id @default(cuid())
  /// Local calendar date, "YYYY-MM-DD". Sorts correctly as a string.
  date         String
  startMinutes Int
  endMinutes   Int

  /// Who holds it. Null while released and unclaimed.
  teamId String?
  team   Team?   @relation("BookingTeam", fields: [teamId], references: [id], onDelete: SetNull)

  /// PENDING | HELD | RELEASED | DECLINED | WITHDRAWN
  status String
  /// ASSIGNED | PICKUP | REQUEST
  origin String

  seriesId String?
  series   AssignedSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  /// Kept when a slot is released, so the calendar can say who gave it up.
  releasedFromTeamId String?
  releasedFromTeam   Team?     @relation("BookingReleasedFrom", fields: [releasedFromTeamId], references: [id], onDelete: SetNull)
  releasedAt         DateTime?
  claimedAt          DateTime?

  /// Set for requested blocks: who asked, who decided, and why not.
  requestedById String?
  requestedBy   User?     @relation("BookingRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedById   String?
  decidedBy     User?     @relation("BookingDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  /// "APP" | "EMAIL" — how the decision was made, so it has a trail.
  decidedVia    String?
  declineReason String?

  decisionTokens DecisionToken[]

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([status])
  @@index([teamId])
  @@index([seriesId])
}

/// When the facility is open to coach requests, one row per weekday.
/// Admin-assigned time may sit outside these hours — the club opens the
/// building when it needs to.
model FacilityHours {
  /// 0 = Sunday … 6 = Saturday.
  weekday      Int      @id
  isOpen       Boolean  @default(true)
  openMinutes  Int
  closeMinutes Int
  updatedAt    DateTime @updatedAt
}

/// A dated override — holidays, tournaments, maintenance. Inclusive bounds.
model Closure {
  id        String   @id @default(cuid())
  startDate String
  endDate   String
  reason    String?
  createdAt DateTime @default(now())

  @@index([startDate])
}

/// One row. The booking rules a super admin can change.
model Settings {
  id                    String   @id @default("singleton")
  blockMinutes          Int      @default(30)
  maxRequestMinutes     Int      @default(90)
  weeksAhead            Int      @default(4)
  minNoticeHours        Int      @default(24)
  maxApprovedPerWeek    Int      @default(3)
  maxOpenRequests       Int      @default(2)
  notifyCoachOnDecision Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

/// One-click approval from the approver's email. Bound to a single booking and
/// a single decision, stored only as a hash, and dead once that booking is
/// decided by any route.
model DecisionToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  bookingId  String
  booking    Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  decision   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([bookingId])
}
