// Facility scheduler — data model.
//
// SQLite for development; switch the provider to "postgresql" for production.
// Prisma enums are not supported on SQLite, so role and status are stored as
// strings and constrained in the application layer (src/lib/domain.ts), which
// is also where the allowed values are defined and validated.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Team {
  id         String    @id @default(cuid())
  /// Shown on the calendar once a block is approved, e.g. "12U Red".
  name       String    @unique
  /// Archived teams keep their history but can no longer be assigned.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  members  User[]
  assigned AssignedSeries[]
  bookings Booking[]        @relation("BookingTeam")
  released Booking[]        @relation("BookingReleasedFrom")

  @@index([archivedAt])
}

/// A person who may sign in. This table *is* the access control: an address
/// that is not here cannot sign in, even with a valid link.
model User {
  id     String  @id @default(cuid())
  /// Always stored lowercase and trimmed — see normalizeEmail().
  email  String  @unique
  name   String?
  /// HEAD_COACH | APPROVER | SUPER_ADMIN
  role   String
  /// INVITED | ACTIVE | DISABLED
  status String

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  invitedAt    DateTime  @default(now())
  lastSignInAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
  signInTokens SignInToken[]

  @@index([role])
  @@index([status])
  @@index([teamId])
}

/// Single-use magic-link token. Only the SHA-256 hash is stored, so a leaked
/// database row cannot be replayed as a sign-in link.
model SignInToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Server-side session. The cookie holds the secret; only its hash is stored,
/// and deleting the row revokes the session immediately.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// A recurring block an admin assigns to a team, e.g. "U9 - White, Saturdays
/// 8:00–9:30, from today through 30 April". Assigned time needs no approval.
///
/// Times are stored as a local calendar date plus minutes from midnight, never
/// as an instant. A series that runs through spring crosses a daylight-saving
/// change, and 8:00 must stay 8:00 on both sides of it.
model AssignedSeries {
  id           String  @id @default(cuid())
  teamId       String
  team         Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  /// 0 = Sunday … 6 = Saturday.
  weekday      Int
  startMinutes Int
  endMinutes   Int
  /// Inclusive "YYYY-MM-DD" bounds.
  startsOn     String
  endsOn       String
  note         String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  occurrences Booking[]

  @@index([teamId])
  @@index([weekday])
}

/// One block of facility time on one day. Assigned occurrences, slots released
/// back to the club, and slots picked up by another team are all this row —
/// there is one row per physical block of time, whoever currently holds it.
model Booking {
  id           String @id @default(cuid())
  /// Local calendar date, "YYYY-MM-DD". Sorts correctly as a string.
  date         String
  startMinutes Int
  endMinutes   Int

  /// Who holds it. Null while released and unclaimed.
  teamId String?
  team   Team?   @relation("BookingTeam", fields: [teamId], references: [id], onDelete: SetNull)

  /// HELD | RELEASED
  status String
  /// ASSIGNED | PICKUP
  origin String

  seriesId String?
  series   AssignedSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  /// Kept when a slot is released, so the calendar can say who gave it up.
  releasedFromTeamId String?
  releasedFromTeam   Team?     @relation("BookingReleasedFrom", fields: [releasedFromTeamId], references: [id], onDelete: SetNull)
  releasedAt         DateTime?
  claimedAt          DateTime?

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([status])
  @@index([teamId])
  @@index([seriesId])
}
