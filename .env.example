# ── App ──────────────────────────────────────────────────────────────────────
# Used to build sign-in links, so it must match how people reach the app.
APP_URL="http://localhost:3000"

# Appears in email copy.
ORG_NAME="Hamilton Jr Chargers"

# Only used to work out what "today" is — times are stored as local wall clock.
FACILITY_TIMEZONE="America/Chicago"

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres in every environment, so what you develop against is what runs.
#
# DATABASE_URL is what the app queries through; DIRECT_DATABASE_URL is what
# migrations use, because a transaction pooler cannot run them. Locally there is
# no pooler, so set both to the same string.
#
# On Neon, the Vercel integration sets both for you — DATABASE_URL pooled and
# DATABASE_URL_UNPOOLED direct. See the README for the one mapping to add.
DATABASE_URL="postgresql://postgres@localhost:5432/facility_dev"
DIRECT_DATABASE_URL="postgresql://postgres@localhost:5432/facility_dev"

# ── Email ────────────────────────────────────────────────────────────────────
# "console" prints messages to the server log — no credentials needed, and the
# sign-in link is right there in the terminal. Use "postmark" in production.
MAIL_TRANSPORT="console"

# Must be an address on a domain verified in Postmark. Sending from a subdomain
# (mail.yourdomain.org) keeps the scheduler's reputation separate from the
# club's everyday mail.
MAIL_FROM="Jr Chargers Facility <no-reply@mail.example.org>"

# Coaches will hit reply whatever the From address says — send it somewhere real.
MAIL_REPLY_TO="facility@example.org"

# From Postmark: Servers → your server → API Tokens.
POSTMARK_SERVER_TOKEN=""

# Transactional stream. "outbound" is the default one Postmark creates.
# Never point this at a broadcast stream: sign-in links are not marketing.
POSTMARK_MESSAGE_STREAM="outbound"

# ── Seed ─────────────────────────────────────────────────────────────────────
# The first account that can sign in and add everyone else. Required by db:seed.
SEED_SUPER_ADMIN_EMAIL=""
SEED_SUPER_ADMIN_NAME="Club Admin"
