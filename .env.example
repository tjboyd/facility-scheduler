# SQLite for local development. Point at Postgres for production and change the
# datasource provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Base URL used to build sign-in links.
APP_URL="http://localhost:3000"

# Leave MAIL_TRANSPORT unset (or "console") in development: sign-in links are
# printed to the server log instead of being emailed.
MAIL_TRANSPORT="console"
MAIL_FROM="Hamilton Jr Chargers Facility <no-reply@jrchargersbaseball.com>"

# Seeded super admin — the first account that can sign in and add everyone else.
SEED_SUPER_ADMIN_EMAIL="you@jrchargersbaseball.com"
SEED_SUPER_ADMIN_NAME="Club Admin"
